# Claude API Configuration
ANTHROPIC_API_KEY=your-api-key-here
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Agent Configuration
DEFAULT_MODEL=sonnet
MAX_TURNS=20
PERMISSION_MODE=acceptEdits

# Allowed Tools (comma separated)
DEFAULT_ALLOWED_TOOLS=Read,Write,Edit,Bash,Glob,Grep,WebSearch,WebFetch

# ============================================================================
# Working Directory Configuration (工作目录配置)
# ============================================================================

# Production Working Directory (生产环境工作目录)
# 用于对话环境的文件操作
# WORK_DIR=/path/to/your/work/directory

# Debug Working Directory (调试环境工作目录)
# 用于调试环境的文件操作（与生产环境完全分离）
# DEBUG_WORK_DIR=/path/to/your/debug/work/directory

# ============================================================================
# Setting Sources Configuration (技能加载来源配置)
# ============================================================================

# Production Setting Sources (生产环境技能来源)
# 用于对话环境的技能加载（逗号分隔）
# SETTING_SOURCES=project,builtin

# Debug Setting Sources (调试环境技能来源)
# 用于调试环境的技能加载（逗号分隔，与生产环境完全分离）
# DEBUG_SETTING_SOURCES=project,builtin

# ============================================================================
# Online Debug Feature (在线调试功能 - 面向用户)
# ============================================================================
# 用户可以在线测试技能效果，查看响应和工具调用
# 调试环境使用独立的 cwd 和 setting_sources，与对话环境完全分离

# Online Debug Max Turns (在线调试最大对话轮次)
# 用户测试技能时的轮次限制（通常比生产环境小）
# ONLINE_DEBUG_MAX_TURNS=10

# ============================================================================
# Session Configuration (会话配置)
# ============================================================================
SESSION_TIMEOUT_SECONDS=3600
MAX_CONCURRENT_SESSIONS=100

# JWT Configuration
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Tavily Search API (Optional)
# AI-powered search engine for web search
# TAVILY_API_KEY=your-tavily-api-key-here

# MinIO Configuration (Optional)
# For file uploads to MinIO/S3 compatible storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
MINIO_BUCKET_NAME=agentic
MINIO_REGION=us-east-1
MINIO_SECURE=false
